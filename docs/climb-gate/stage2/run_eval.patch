+def run_single_query(
+    query: str,
+    skill_name: str,
+    skill_description: str,
+    timeout: int,
+    project_root: str,
+    model: str | None = None,
+) -> bool:
+    """Patched: time the run and append one sidecar line per run to $CLIMB_RUNS_FILE.
+
+    The sidecar carries what a kit record needs and the loop's summary drops: the run's
+    outcome, its wall clock, the harness overhead, the served model from the stream's init
+    event, and the digest of the description under test. The exporter turns it into records.
+    """
+    import datetime as _dt
+    import hashlib as _hashlib
+
+    global _LAST_MODEL
+    _LAST_MODEL = None
+    started = _dt.datetime.now(_dt.UTC)
+    t0 = time.monotonic()
+    # patched: one project root per worker process. Concurrent workers in one root each write a
+    # candidate command, and a session that sees several identical candidates invokes none of
+    # them. $CLIMB_ROOT_TEMPLATE is copied (without .git) to $CLIMB_ROOTS/<pid> once per process.
+    template, roots = os.environ.get("CLIMB_ROOT_TEMPLATE"), os.environ.get("CLIMB_ROOTS")
+    if template and roots:
+        import shutil as _shutil
+
+        own = Path(roots) / str(os.getpid())
+        if not own.exists():
+            _shutil.copytree(template, own, ignore=_shutil.ignore_patterns(".git"), symlinks=True)
+            (own / ".claude" / "commands").mkdir(parents=True, exist_ok=True)
+        project_root = str(own)
+    triggered = _run_single_query_inner(query, skill_name, skill_description, timeout, project_root, model)
+    inner_ms = round((time.monotonic() - t0) * 1000)
+    path = os.environ.get("CLIMB_RUNS_FILE")
+    if path:
+        wall_ms = round((time.monotonic() - t0) * 1000)
+        line = json.dumps(
+            {
+                "query": query,
+                "description_sha256": _hashlib.sha256(skill_description.encode()).hexdigest(),
+                "triggered": triggered,
+                "wall_ms": wall_ms,
+                "harness_ms": max(wall_ms - inner_ms, 0),
+                "served_model": _LAST_MODEL,
+                "started_at": started.strftime("%Y-%m-%dT%H:%M:%SZ"),
+            }
+        )
+        with open(path, "a") as f:
+            f.write(line + "\n")
+    return triggered
+
